APP_NAME=SaulAI

# Chat completion providers
# Default model is gpt-5.5. If GPT 5.5 is unavailable, choose gemini-2.5-flash in the UI/API
# or set DEFAULT_CHAT_MODEL=gemini-2.5-flash.
OPENAI_API_KEY=<openai-api-key>
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.5
OPENAI_QA_MODEL=gpt-5.5
DEFAULT_CHAT_MODEL=gpt-5.5

GEMINI_API_KEY=<gemini-api-key>
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_QA_MODEL=gemini-2.5-flash
GEMINI_ENRICH_MODEL=gemini-2.5-flash

# Graph RAG
EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASS=<neo4j-password>
NEO4J_VECTOR_INDEX_NAME=chunk_embedding_index

# MySQL, Redis, authentication
MYSQL_ROOT_PASSWORD=<mysql-root-password>
MYSQL_DATABASE=qna
MYSQL_HOST=localhost
MYSQL_PORT=3307
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_TTL_SECONDS=86400
ACCESS_TOKEN_KEY=<jwt-access-token-secret>

# Runtime options
QNA_THREADS=4
LLM_TIMEOUT=600
